# GitHub's language statistics should describe the code that is actually
# written here, not what the toolchain scaffolds.

# Wails scaffolds the NSIS installer scripts and the Windows manifest.
build/windows/installer/* linguist-vendored
build/windows/*.manifest linguist-vendored
build/darwin/* linguist-vendored

# Go bindings generated by `wails build` — never edited by hand.
frontend/wailsjs/** linguist-generated

# Lockfiles are noise in diffs and in the statistics.
frontend/package-lock.json linguist-generated -diff

# Keep line endings sane across WSL, Windows and macOS.
* text=auto eol=lf
*.png binary
*.ico binary
